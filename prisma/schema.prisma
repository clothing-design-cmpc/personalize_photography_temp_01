// LensVerse — Prisma Schema
// Models: Portfolio, Schedule, Booking, Blog, Testimonial, Message, ClientGallery

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Portfolio ──────────────────────────────────────────────────────────────
// Stores each photography project with its images and metadata
model Portfolio {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  category    String
  location    String
  year        Int
  coverImage  String
  description String
  images      String[]
  videoUrl    String?
  isFeatured  Boolean     @default(false)
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  testimonial Testimonial?
}

// ─── Schedule ────────────────────────────────────────────────────────────────
// Tracks available, pending, booked, and blocked time slots
model Schedule {
  id        String   @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  // AVAILABLE | PENDING | BOOKED | BLOCKED
  status    String   @default("AVAILABLE")
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
}

// ─── Booking ─────────────────────────────────────────────────────────────────
// Stores visitor booking submissions from the 7-step booking wizard
model Booking {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String
  address     String?
  eventType   String
  eventDate   DateTime
  eventTime   String
  serviceType String
  location    String
  guestCount  Int?
  budget      String?
  message     String?
  // PENDING | APPROVED | REJECTED | COMPLETED | CANCELLED
  status      String     @default("PENDING")
  totalPrice  Float?
  stripeId    String?
  createdAt   DateTime   @default(now())
  schedules   Schedule[]
}

// ─── Blog ────────────────────────────────────────────────────────────────────
// Photography blog posts with categories and tags
model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  category    String
  tags        String[]
  readTime    Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Testimonial ─────────────────────────────────────────────────────────────
// Client testimonials — optionally linked to a Portfolio entry
model Testimonial {
  id          String     @id @default(cuid())
  clientName  String
  occasion    String
  rating      Int
  quote       String
  photoUrl    String?
  videoUrl    String?
  portfolioId String?    @unique
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
  createdAt   DateTime   @default(now())
}

// ─── Message ──────────────────────────────────────────────────────────────────
// Contact form submissions from visitors
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
}

// ─── ClientGallery ───────────────────────────────────────────────────────────
// Token-protected private galleries for delivered client photos
model ClientGallery {
  id         String    @id @default(cuid())
  token      String    @unique
  clientName String
  shootDate  DateTime
  images     String[]
  password   String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}
