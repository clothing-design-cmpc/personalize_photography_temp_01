generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USER (Admin/Staff) ───────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("STAFF")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ─── SITE SETTINGS ───────────────────────────────────────────────────────────

model SiteSettings {
  id                 String   @id @default(cuid())
  siteName           String   @default("LensVerse")
  siteTagline        String?
  contactEmail       String?
  phone              String?
  address            String?
  workingHours       String   @default("Mon-Fri 9AM-6PM")
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  youtubeUrl         String?
  seoTitle           String?
  seoDescription     String?
  ogImageUrl         String?
  depositPercent     Int      @default(50)
  currency           String   @default("PHP")
  availableDays      String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  availableStartTime String   @default("09:00")
  availableEndTime   String   @default("18:00")
  slotDurationMins   Int      @default(60)
}

// ─── PORTFOLIO ────────────────────────────────────────────────────────────────

model Portfolio {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    String
  location    String
  year        Int
  coverImage  String
  description String
  images      String[]
  videoUrl    String?
  isFeatured  Boolean      @default(false)
  isPublished Boolean      @default(true)
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  testimonial Testimonial?
}

// ─── TESTIMONIAL ─────────────────────────────────────────────────────────────

model Testimonial {
  id          String     @id @default(cuid())
  clientName  String
  occasion    String
  rating      Int
  quote       String
  photoUrl    String?
  videoUrl    String?
  portfolioId String?    @unique
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
  createdAt   DateTime   @default(now())
}

// ─── BLOG ─────────────────────────────────────────────────────────────────────

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  category    String
  tags        String[]
  readTime    Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── SCHEDULE ─────────────────────────────────────────────────────────────────

model Schedule {
  id        String   @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    String   @default("AVAILABLE")
  note      String?
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
}

// ─── BOOKING ──────────────────────────────────────────────────────────────────

model Booking {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String
  address     String?
  eventType   String
  eventDate   DateTime
  eventTime   String
  serviceType String
  packageTier String?
  location    String
  guestCount  Int?
  budget      String?
  message     String?
  status      String     @default("PENDING")
  totalPrice  Float?
  stripeId    String?
  adminNotes  String?
  createdAt   DateTime   @default(now())
  schedules   Schedule[]
}

// ─── MESSAGE ─────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  status     String   @default("unread")
  adminNotes String?
  createdAt  DateTime @default(now())
}

// ─── CLIENT GALLERY ───────────────────────────────────────────────────────────

model ClientGallery {
  id         String    @id @default(cuid())
  token      String    @unique
  clientName String
  shootDate  DateTime
  images     String[]
  password   String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}
